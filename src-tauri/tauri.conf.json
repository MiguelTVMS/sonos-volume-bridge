{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SonosVolumeBridge",
  "version": "0.1.0",
  "identifier": "com.sonosvolumebridge.app",
  "build": { "frontendDist": "../ui/dist", "devUrl": "http://localhost:5173", "beforeDevCommand": "npm --prefix ../ui run dev", "beforeBuildCommand": "npm --prefix ../ui run build" },
  "app": { "windows": [{ "label": "main", "title": "SonosVolumeBridge Settings", "width": 640, "height": 760, "visible": false, "resizable": true }], "security": { "capabilities": ["main-capability"] } },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/icon.png"] }
}
