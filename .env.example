# Copy to .env.development and fill with your local values.
# Keep .env.development out of git; this file is intentionally committed.

# Optional Node / pnpm bootstrap (if you want to keep these in one place)
# Node is expected to be 22.x for local parity with CI.
# NODE_VERSION=22

# ----- Shared signing defaults -----

# If you prefer one shared password, use the same value for the three password
# fields below.
KEYCHAIN_PASSWORD=

# Optional shared cert password for local workflows. If set, keep the per-cert
# password variables empty and the local loader will fill them automatically.
APPLE_SHARED_CERT_PASSWORD=replace-with-common-cert-password

# ----- Apple Developer ID signing (verify-macos-signing) -----
APPLE_SIGNING_IDENTITY="Developer ID Application: João Miguel Tabosa Vaz Marques Silva (UC5ZUS8FLD)"
APPLE_TEAM_ID=UC5ZUS8FLD
APPLE_API_ISSUER=e04ec572-ae60-4890-8249-b499ad0ab968
APPLE_API_KEY=9FRBZ852TB
APPLE_CERTIFICATE=replace-with-base64-p12
APPLE_CERTIFICATE_PASSWORD=
APPLE_API_PRIVATE_KEY=replace-with-p8-file-contents

# ----- Apple App Store signing (verify-macos-app-store-signing) -----
APPLE_APP_STORE_SIGNING_IDENTITY="subject=C=PT,O=João Miguel Tabosa Vaz Marques Silva,OU=UC5ZUS8FLD,CN=3rd Party Mac Developer Application: João Miguel Tabosa Vaz Marques Silva (UC5ZUS8FLD),UID=UC5ZUS8FLD"
APPLE_MAC_INSTALLER_IDENTITY="subject=C=PT,O=João Miguel Tabosa Vaz Marques Silva,OU=UC5ZUS8FLD,CN=3rd Party Mac Developer Installer: João Miguel Tabosa Vaz Marques Silva (UC5ZUS8FLD),UID=UC5ZUS8FLD"
