{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sonos Volume Bridge",
  "identifier": "ms.miguel.sonosvolumebridge.desktop",
  "build": { "frontendDist": "../ui/dist", "devUrl": "http://localhost:5173", "beforeDevCommand": "npm --prefix ./ui run dev", "beforeBuildCommand": "npm --prefix ./ui run build" },
  "app": { "windows": [{ "label": "main", "title": "Sonos Volume Bridge Settings", "width": 600, "minWidth": 600, "maxWidth": 600, "height": 500, "minHeight": 460, "visible": false, "resizable": true }], "security": { "capabilities": ["main-capability"] } },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.icns", "icons/icon.ico", "icons/icon.png"],
    "windows": { "nsis": { "template": "./windows/installer.nsi" } }
  }
}

