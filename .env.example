# Copy to .env.development and fill with your local values.
# Keep .env.development out of git; this file is intentionally committed.

# Optional Node / pnpm bootstrap (if you want to keep these in one place)
# Node is expected to be 22.x for local parity with CI.
# NODE_VERSION=22

# ----- Shared signing defaults -----

# If you prefer one shared password, use the same value for the three password
# fields below.
KEYCHAIN_PASSWORD=replace-with-keychain-password

# ----- Apple Developer ID signing (verify-macos-signing) -----
APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAM_ID)"
APPLE_TEAM_ID=replace-with-team-id
APPLE_API_ISSUER=replace-with-api-issuer-id
APPLE_API_KEY=replace-with-api-key-id
APPLE_CERTIFICATE=replace-with-base64-p12
APPLE_CERTIFICATE_PASSWORD=replace-with-cert-password
APPLE_API_PRIVATE_KEY=replace-with-p8-file-contents

# ----- Apple App Store signing (verify-macos-app-store-signing) -----
APPLE_APP_STORE_SIGNING_IDENTITY="3rd Party Mac Developer Application: Your Name (TEAM_ID)"
APPLE_MAC_INSTALLER_IDENTITY="3rd Party Mac Developer Installer: Your Name (TEAM_ID)"
APPLE_APP_STORE_CERTIFICATE=replace-with-base64-p12
APPLE_APP_STORE_CERTIFICATE_PASSWORD=replace-with-app-store-cert-password
APPLE_MAC_INSTALLER_CERTIFICATE=replace-with-base64-p12
APPLE_MAC_INSTALLER_CERTIFICATE_PASSWORD=replace-with-installer-cert-password
APPLE_APP_STORE_PROVISIONING_PROFILE=replace-with-base64-profile

