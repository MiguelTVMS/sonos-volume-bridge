# Copy to .env.development and fill with your local values.
# Keep .env.development out of git; this file is intentionally committed.

# Optional Node / pnpm bootstrap (if you want to keep these in one place)
# Node is expected to be 22.x for local parity with CI.
# NODE_VERSION=22

# ----- Shared signing defaults -----

# If you prefer one shared password, use the same value for the three password
# fields below.
# Source: the password you used when exporting each .p12 from Keychain Access.
# To create this value from local files:
#   - Keep one secure local value if all cert exports use the same password.
#   - Or set each individual password field below.
KEYCHAIN_PASSWORD=replace-with-keychain-password

# Optional shared cert password for local workflows. If set, keep the per-cert
# password variables empty and the local loader will fill them automatically.
APPLE_SHARED_CERT_PASSWORD=replace-with-common-cert-password

# ----- Apple Developer ID signing (verify-macos-signing) -----
# Get this group from Apple Developer / App Store Connect:
# - APPLE_TEAM_ID: in Apple Developer membership list or the App Store Connect team
#   selector.
# - APPLE_SIGNING_IDENTITY: from the certificate subject in Keychain Access after
#   importing your Developer ID Application certificate.
# - APPLE_API_ISSUER / APPLE_API_KEY: create in App Store Connect > Users and
#   Access > Keys. Keep the key ID and issuer exactly as shown.
# - APPLE_CERTIFICATE: export Developer ID Application certificate + private key as a
#   .p12 in Keychain Access, then base64 encode it.
#     base64 -i path/to/DevID-App.p12 | tr -d '\n'
# - APPLE_CERTIFICATE_PASSWORD: password used when exporting that .p12.
# - APPLE_API_PRIVATE_KEY: contents of the .p8 file generated in App Store Connect.
APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAM_ID)"
APPLE_TEAM_ID=replace-with-team-id
APPLE_API_ISSUER=replace-with-api-issuer-id
APPLE_API_KEY=replace-with-api-key-id
APPLE_CERTIFICATE=replace-with-base64-p12
APPLE_CERTIFICATE_PASSWORD=
APPLE_API_PRIVATE_KEY=replace-with-p8-file-contents

# ----- Apple App Store signing (verify-macos-app-store-signing) -----
# Get this group from Apple Developer:
# - APPLE_APP_STORE_SIGNING_IDENTITY: from "3rd Party Mac Developer Application" cert
#   subject.
# - APPLE_MAC_INSTALLER_IDENTITY: from "3rd Party Mac Developer Installer" cert
#   subject.
# - APPLE_APP_STORE_CERTIFICATE: export Apple Distribution certificate + key as .p12,
#   then base64 encode.
#     base64 -i path/to/Apple-Distribution.p12 | tr -d '\n'
# - APPLE_MAC_INSTALLER_CERTIFICATE: export Mac Installer Distribution certificate + key
#   as .p12, then base64 encode.
#     base64 -i path/to/Mac-Installer-Distribution.p12 | tr -d '\n'
# - APPLE_*_CERTIFICATE_PASSWORD: password used when exporting the matching .p12.
# - APPLE_APP_STORE_PROVISIONING_PROFILE: download the App Store provisioning profile
#   used by the app and base64 encode it.
#     base64 -i path/to/Sonos_Volume_Bridge_Mac_App_Store.provisionprofile | tr -d '\n'
APPLE_APP_STORE_SIGNING_IDENTITY="3rd Party Mac Developer Application: Your Name (TEAM_ID)"
APPLE_MAC_INSTALLER_IDENTITY="3rd Party Mac Developer Installer: Your Name (TEAM_ID)"
APPLE_APP_STORE_CERTIFICATE=replace-with-base64-p12
APPLE_APP_STORE_CERTIFICATE_PASSWORD=
APPLE_MAC_INSTALLER_CERTIFICATE=replace-with-base64-p12
APPLE_MAC_INSTALLER_CERTIFICATE_PASSWORD=
APPLE_APP_STORE_PROVISIONING_PROFILE=replace-with-base64-profile
