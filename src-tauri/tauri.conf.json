{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Speaker Volume Bridge",
  "identifier": "ms.miguel.sonosvolumebridge.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ./ui run dev",
    "beforeBuildCommand": "npm --prefix ./ui run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Speaker Volume Bridge Settings",
        "width": 600,
        "minWidth": 600,
        "maxWidth": 600,
        "height": 650,
        "minHeight": 460,
        "visible": false,
        "resizable": true
      }
    ],
    "security": {
      "capabilities": [
        "main-capability"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "macOS": {
      "entitlements": "./Entitlements.plist",
      "minimumSystemVersion": "13.0"
    },
    "windows": {
      "nsis": {
        "template": "./windows/installer.nsi"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "pulseaudio-utils"
        ],
        "conflicts": [
          "sonos-volume-bridge"
        ],
        "replaces": [
          "sonos-volume-bridge"
        ],
        "provides": [
          "sonos-volume-bridge"
        ],
        "postInstallScript": "../packaging/linux/postinst",
        "postRemoveScript": "../packaging/linux/postrm"
      }
    }
  }
}
